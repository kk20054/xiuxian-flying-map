; 修仙御空 · 云梦山舆图 — Godot 4 port of the Three.js "Xiuxian Flying Demo" (see ../docs).
; World unit = 1 丈 (as in the demo). +x east, +z south, +y up; the camera always faces north (−z).

config_version=5

[application]

config/name="修仙御空 · 云梦山舆图"
config/description="Godot 4 port of the Xiuxian Flying Demo: fly over a living 青绿 ink-landscape map, fold it into a 舆图."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4")
boot_splash/bg_color=Color(0.925, 0.894, 0.812, 1)
boot_splash/show_image=false

[autoload]

Cfg="*res://scripts/autoload/cfg.gd"
World="*res://scripts/autoload/world.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/custom="res://ui/theme/ink_theme.tres"
theme/default_font_multichannel_signed_distance_field=false

